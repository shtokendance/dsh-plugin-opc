{
  "name": "dsh-plugin-opc",
  "version": "0.1.6",
  "description": "OPC Enterprise Plugin for DeepSeek Harness (DSH)",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shtokendance/dsh-plugin-opc.git"
  },
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-alpha.3 <0.3.0"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.dsh.json",
    "build": "node scripts/generate-remote.mjs && node scripts/build.mjs",
    "prepublishOnly": "npm run test && npm run build",
    "configure:dsh": "node scripts/configure-dsh.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "open": "^11.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "runtime",
    "README.md",
    "config/overlay.example.yml",
    "docs"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "bundle": {
      "patch": "./config/overlay.example.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.2-alpha.3 <0.3.0",
    "@deepseek-ai/schemastery": "3.18.6-alpha.2 || 3.19.0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-alpha.3 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
